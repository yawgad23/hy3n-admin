rules_version = '2';

// Firestore Security Rules — HY3N Admin & Rider (project: hy3n26)
//
// Allows read/write to all collections for admin users whitelisted by email.
// Otherwise falls back to specific rider/driver ownership rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to determine if authenticated user is a whitelisted Admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email.lower() == 'yawgad23@gmail.com' ||
         request.auth.token.email.lower() == 'hy3ntransportservices@gmail.com');
    }

    // ─── Whitelisted Admin access ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ─── Standard Rider / Driver rules ──────────────────────────────────────

    // Rider's own profile. Auto-ID document with a `user_id` field (not doc-id-as-uid).
    match /rider_profiles/{profileId} {
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Wallet balance — doc ID is the rider's uid. All writes happen server-side
    // (tRPC wallet.topup + Hubtel webhook via Admin SDK), so the client is read-only.
    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Wallet transactions — created/updated only by the server. Client reads its own.
    match /wallet_transactions/{txId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // Rides — rider creates/owns; driver_id clause supports the driver app sharing
    // this same Firestore database. rider_id is immutable after creation.
    match /rides/{rideId} {
      allow read: if request.auth != null &&
        (resource.data.rider_id == request.auth.uid || resource.data.driver_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.rider_id == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.rider_id == request.auth.uid || resource.data.driver_id == request.auth.uid) &&
        request.resource.data.rider_id == resource.data.rider_id;
      allow delete: if false;
    }

    // In-ride chat. Membership is checked against the parent ride doc.
    match /ride_messages/{messageId} {
      allow read, delete: if request.auth != null &&
        (get(/databases/$(database)/documents/rides/$(resource.data.ride_id)).data.rider_id == request.auth.uid ||
         get(/databases/$(database)/documents/rides/$(resource.data.ride_id)).data.driver_id == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.sender_id == request.auth.uid &&
        (get(/databases/$(database)/documents/rides/$(request.resource.data.ride_id)).data.rider_id == request.auth.uid ||
         get(/databases/$(database)/documents/rides/$(request.resource.data.ride_id)).data.driver_id == request.auth.uid);
      // markMessagesAsRead flips `read` on the OTHER participant's messages.
      allow update: if request.auth != null &&
        (get(/databases/$(database)/documents/rides/$(resource.data.ride_id)).data.rider_id == request.auth.uid ||
         get(/databases/$(database)/documents/rides/$(resource.data.ride_id)).data.driver_id == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Driver directory — riders need to see available drivers to be matched.
    // Profile owner (driver) manages their own doc.
    match /driver_profiles/{driverId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Support tickets — rider creates/reads own; status changes are back-office only.
    match /support_tickets/{ticketId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Lost-item / ride reports — filed by riders (lost_item) or drivers (found_item).
    // driver_id clause mirrors the rides rule so both apps can share this collection.
    match /ride_reports/{reportId} {
      allow read: if request.auth != null &&
        (resource.data.rider_id == request.auth.uid || resource.data.driver_id == request.auth.uid);
      allow create: if request.auth != null &&
        (request.resource.data.rider_id == request.auth.uid || request.resource.data.driver_id == request.auth.uid);
      allow update, delete: if false;
    }

    // Daily platform fee commission records
    match /daily_commissions/{commissionId} {
      allow read: if request.auth != null && 
        (resource.data.driver_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
        (request.resource.data.driver_id == request.auth.uid || isAdmin());
      allow update: if request.auth != null && 
        (resource.data.driver_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
